{
  "type": "object",
  "additionalProperties": false,
  "required": ["scenes", "corners", "outside", "overall"],
  "properties": {
    "scenes": {
      "type": "array",
      "description": "場面 0 から 5 まで、一つずつ",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene", "reached", "understood", "gist"],
        "properties": {
          "scene": {"type": "integer", "minimum": 0, "maximum": 5},
          "reached": {"type": "boolean", "description": "知らせ（場面 0 では設定）がその人に届いたか"},
          "understood": {"type": "integer", "minimum": 0, "maximum": 3,
                         "description": "0 何の知らせか分からない / 1 危ないらしいことだけ / 2 何の危険かまで / 3 危険・場所・見る所まで"},
          "gist": {"type": "string", "description": "その人が受けとったこと、したこと（日本語で短く）"}
        }
      }
    },
    "corners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene", "where", "quote", "kind", "why", "severity", "fix_hint"],
        "properties": {
          "scene": {"type": "integer", "minimum": 0, "maximum": 5},
          "where": {"type": "string",
                    "enum": ["通知の題", "たたんだ1行", "本文", "ボタン", "アプリの画面", "PCの画面", "届き方", "はじめの設定"]},
          "quote": {"type": "string"},
          "kind": {"type": "string",
                   "enum": ["言葉", "漢字・読み", "言語", "長さ・量", "順番", "色", "音・振動", "操作", "数字・単位", "読み上げ", "届かない", "その他"]},
          "why": {"type": "string"},
          "severity": {"type": "integer", "minimum": 1, "maximum": 3},
          "fix_hint": {"type": "string"}
        }
      }
    },
    "outside": {"type": "array", "items": {"type": "string"}, "description": "いまのサークルに無い働きで、あれば助かるもの"},
    "overall": {"type": "string", "description": "その人から見た、ひとことの感想"}
  }
}
