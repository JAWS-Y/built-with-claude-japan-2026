{
 "answer": {
  "groups": [
   {
    "id": "G01",
    "name": "強い音・ふるえをくり返す",
    "what": "警報は特別な音やふるえ、全画面で出す。開くまでくり返し鳴らし、通知を残す。"
   },
   {
    "id": "G02",
    "name": "光・腕時計で知らせる",
    "what": "カメラのライトや画面の点滅、腕時計のふるえなど、耳に頼らない合図を使う。"
   },
   {
    "id": "G03",
    "name": "近くの危ない物を名指し",
    "what": "案内の1文や題で、いまいる所に近い川・道・地下などを名指しする。"
   },
   {
    "id": "G04",
    "name": "登録した家・道の物を名指し",
    "what": "家やよく通る道を前もって登録し、その近くの危ない所を知らせる。"
   },
   {
    "id": "G05",
    "name": "危ない所に近づくと再通知",
    "what": "警報が出ているあいだ、PCが位置を見て、冠水想定の所に近づいたらもう一度知らせる。"
   },
   {
    "id": "G06",
    "name": "浸水想定区域の中かを出す",
    "what": "公式のハザードマップで、いる所や家が浸水想定区域の中か、想定の深さを出す。"
   },
   {
    "id": "G07",
    "name": "公式の川の水位を出す",
    "what": "近くの観測所の公式の水位と氾濫危険水位などを、数字や図で出す。"
   },
   {
    "id": "G08",
    "name": "冠水想定の所を並べ地図に",
    "what": "冠水想定の所を全部、名前・距離つきで並べたり、自分の位置と地図に重ねたりする。"
   },
   {
    "id": "G09",
    "name": "ほかの言葉の決まった訳",
    "what": "気象庁の多言語辞書や人が作った決まった訳で、警報名と案内をほかの言葉でも出す。"
   },
   {
    "id": "G10",
    "name": "英語の文を先に出す",
    "what": "決まった英語の文や英語の名前を、題やたたんだ通知に出す。"
   },
   {
    "id": "G11",
    "name": "ひらがな・ふりがなを付ける",
    "what": "漢字にふりがなを付け、ひらがなの行を大きく上に出す。"
   },
   {
    "id": "G12",
    "name": "たたんだ通知の行を変える",
    "what": "たたんだ通知の題や2行目に、案内の1文やひらがなの言いかえを出す。"
   },
   {
    "id": "G13",
    "name": "声で読み上げる",
    "what": "届いたら自動で、またはボタンで読み上げる。車やイヤホン、読み上げの順も整える。"
   },
   {
    "id": "G14",
    "name": "絵・色・段で強さを見せる",
    "what": "川があふれる絵、大きな「3」、5段の帯、色だけに頼らない形で警報を見せる。"
   },
   {
    "id": "G15",
    "name": "レベル3の公式の意味を添える",
    "what": "警戒レベル3＝高齢者等避難などの公式の意味を、ほかの言葉でも添える。"
   },
   {
    "id": "G16",
    "name": "区の避難情報・避難所を出す",
    "what": "新宿区の高齢者等避難の発令、避難所、窓口の電話を出す。"
   },
   {
    "id": "G17",
    "name": "どう動くかを書く",
    "what": "「高い所へ」「アンダーを通らない」などの動き方や、通る道を示す。"
   },
   {
    "id": "G18",
    "name": "家族などにも同時に届ける",
    "what": "本人が決めた家族や支える人の携帯にも、同じ知らせ（位置つきの案もある）を届ける。"
   },
   {
    "id": "G19",
    "name": "家族へ送る・電話のボタン",
    "what": "知らせの文を一押しで家族に送ったり、電話をかけたりできるボタンを付ける。"
   },
   {
    "id": "G20",
    "name": "公式ページへのリンク",
    "what": "気象庁の多言語ページ、ハザードマップ、区のページなどへのリンクを付ける。"
   },
   {
    "id": "G21",
    "name": "手話の動画を付ける",
    "what": "案内の文や警報の種類に、手話の動画や公式の手話情報を付ける。"
   },
   {
    "id": "G22",
    "name": "押しやすさ・見分けやすさ",
    "what": "押す所を大きくし、アプリ名や「開いても変わらない」の表示で安心して開けるようにする。"
   },
   {
    "id": "G23",
    "name": "レベルや水位の変化で再通知",
    "what": "レベルが上がった・下がった、水位が上がったときにもう一度知らせる。"
   },
   {
    "id": "G24",
    "name": "ほかの警報もまとめて見せる",
    "what": "大雨警報なども並べて出し、出かける前に一か所で見られるようにする。"
   }
  ],
