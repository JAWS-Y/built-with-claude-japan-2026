{
  "type": "object",
  "additionalProperties": false,
  "required": ["screens", "corners", "outside", "overall"],
  "properties": {
    "screens": {
      "type": "array",
      "description": "画面 1 から 4 まで、一つずつ",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["screen", "understood", "gist"],
        "properties": {
          "screen": {"type": "integer", "minimum": 1, "maximum": 4},
          "understood": {"type": "integer", "minimum": 0, "maximum": 3,
                         "description": "0 何の知らせか分からない / 1 危ないらしいことだけ / 2 何の危険かまで / 3 危険・場所・見る所まで"},
          "gist": {"type": "string", "description": "その人が受けとったこと、したこと（日本語で短く）"}
        }
      }
    },
    "corners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["screen", "where", "quote", "kind", "why", "severity", "fix_hint"],
        "properties": {
          "screen": {"type": "integer", "minimum": 1, "maximum": 4},
          "where": {"type": "string",
                    "enum": ["通知の題", "たたんだ1行", "本文", "ボタン", "アプリの画面", "見守り・設定"]},
          "quote": {"type": "string"},
          "kind": {"type": "string",
                   "enum": ["言葉", "漢字・読み", "言語", "長さ・量", "文字が切れる", "行の変わり目", "文字の大きさ",
                            "同じものが何度も", "古い情報", "並び・順番", "色", "数字・単位", "読み上げ", "操作", "その他"]},
          "why": {"type": "string"},
          "severity": {"type": "integer", "minimum": 1, "maximum": 3},
          "fix_hint": {"type": "string"}
        }
      }
    },
    "outside": {"type": "array", "items": {"type": "string"}, "description": "いまのサークルに無い働きで、あれば助かるもの"},
    "overall": {"type": "string", "description": "その人から見た、ひとことの感想"}
  }
}
