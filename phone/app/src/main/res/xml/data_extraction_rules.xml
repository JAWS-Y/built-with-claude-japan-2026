<?xml version="1.0" encoding="utf-8"?>
<!-- 設定（Firebase の宛先と携帯の id）は、この携帯の中だけに置く。新しい携帯へ移さない。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </device-transfer>
</data-extraction-rules>
